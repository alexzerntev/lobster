{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2024", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "..",
		"outDir": "dist/types",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"sourceMap": false
	},
	"include": ["src/index.ts", "src/assets.d.ts"],
	"exclude": ["dist", "node_modules"]
}
