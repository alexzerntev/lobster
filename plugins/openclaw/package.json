{
	"name": "@clawdbot/lobster-viewer",
	"version": "2026.9.13",
	"description": "Read-only Lobster workflow viewer for OpenClaw",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openclaw/lobster.git",
		"directory": "plugins/openclaw"
	},
	"files": [
		"dist",
		"openclaw.plugin.json",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
		"test": "tsx --test src/*.test.ts",
		"lint": "oxlint --config ../../ui/.oxlintrc.json --tsconfig tsconfig.json src build.mjs",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"chokidar": "5.0.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"openclaw": "2026.9.6",
		"oxlint": "^1.82.0",
		"tsx": "4.23.13",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"openclaw": "2026.9.6"
	},
	"peerDependenciesMeta": {
		"openclaw": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.16.0 <25 || >=26.1.0"
	},
	"packageManager": "pnpm@12.4.1",
	"openclaw": {
		"extensions": [
			"./dist/index.js"
		],
		"compat": {
			"pluginApi": "2026.9.6"
		},
		"build": {
			"openclawVersion": "2026.9.6"
		}
	}
}
