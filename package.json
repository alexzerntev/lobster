{
	"name": "@clawdbot/lobster",
	"version": "2026.9.13",
	"description": "Workflow runtime for AI agents - deterministic pipelines with approval gates",
	"keywords": [
		"ai-agent",
		"approval",
		"automation",
		"lobster",
		"openclaw",
		"pipeline",
		"workflow"
	],
	"homepage": "https://github.com/openclaw/lobster#readme",
	"bugs": {
		"url": "https://github.com/openclaw/lobster/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openclaw/lobster.git"
	},
	"bin": {
		"clawd.invoke": "bin/clawd.invoke.js",
		"lobster": "bin/lobster.js",
		"openclaw.invoke": "bin/openclaw.invoke.js"
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"LICENSE",
		"VISION.md"
	],
	"type": "module",
	"main": "./dist/src/sdk/index.js",
	"exports": {
		".": "./dist/src/sdk/index.js",
		"./sdk": "./dist/src/sdk/index.js",
		"./core": "./dist/src/core/index.js",
		"./recipes/github": "./dist/src/recipes/github/index.js"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "pnpm clean && tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @clawdbot/lobster-viewer typecheck && pnpm --filter @lobster/dev-web typecheck",
		"format": "oxfmt --write package.json tsconfig.json tsconfig.build.json bin src test dev ui",
		"format:check": "oxfmt --check package.json tsconfig.json tsconfig.build.json bin src test dev ui",
		"lint": "pnpm format:check && oxlint --tsconfig tsconfig.json bin src test && pnpm --filter @lobster/dev-web lint && pnpm --filter @clawdbot/lobster-viewer lint",
		"fmt": "pnpm format",
		"test": "pnpm clean && tsc -p tsconfig.json && node -e \"if (!require('fs').existsSync('dist/test')) process.exit(1)\" && node --test dist/test/*.test.js && pnpm test:web",
		"check:changed": "pnpm run test",
		"test:changed": "pnpm run test",
		"crabbox:hydrate": "crabbox actions hydrate",
		"crabbox:run": "crabbox run",
		"crabbox:stop": "crabbox stop",
		"crabbox:warmup": "crabbox warmup",
		"dev:web": "pnpm --filter @lobster/dev-web dev",
		"test:web": "pnpm --filter @lobster/dev-web test && pnpm --filter @clawdbot/lobster-viewer test",
		"test:web:browser": "pnpm --filter @lobster/dev-web test:browser",
		"test:theme:openclaw": "pnpm --filter @lobster/dev-web test:theme:openclaw",
		"build:viewer": "pnpm --filter @clawdbot/lobster-viewer build",
		"test:viewer-package": "pnpm --filter @clawdbot/lobster-viewer test:package"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.2",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.4.1"
}
