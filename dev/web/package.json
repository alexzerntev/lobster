	},
	"devDependencies": {
		"@dagrejs/dagre": "3.1.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@xyflow/react": "12.11.6",
		"highlight.js": "11.12.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tsx": "4.23.13",
		"vite": "8.3.0",
		"yaml": "2.9.0"
	}
}
